  "cSpell.ignorePaths": [
    "uv.lock"
  ],
  // Keep TOML files (pyproject.toml, ruff.toml) on the `toml` language so the
  // Ruff extension does not try to parse them as Python and report spurious
  // "Invalid assignment target" syntax errors.
  "files.associations": {
    "*.toml": "toml"
  },
  "python.defaultInterpreterPath": "e:\\dev\\APPLICATIONS\\Bots\\Telegram\\stickfix\\.venv\\Scripts\\python.exe",
  // Stickfix standardizes on Ruff (see ruff.toml) for linting and formatting.
  // There is no pylintrc, and Pylint's stock conventions (e.g. mandatory module
  // and function docstrings on tests) are noise that the codebase deliberately
  // does not follow. Disable it so diagnostics come from Ruff only.
  "pylint.enabled": false,
  "spellright.documentTypes": [
    "markdown",
    "latex",
    "plaintext"
  ],
  "spellright.language": [
    "en"
  ],
  "workbench.colorCustomizations": {
    "activityBar.background": "#161E7A",
    "statusBar.background": "#161E7A",
    "statusBar.debuggingBackground": "#161E7A",
    "statusBar.debuggingForeground": "#FAFBFE",
    "statusBar.foreground": "#FAFBFE",
    "statusBar.noFolderBackground": "#161E7A",
    "statusBar.noFolderForeground": "#FAFBFE",
    "titleBar.activeBackground": "#1F2AAB",
    "titleBar.activeForeground": "#FAFBFE",
    "titleBar.inactiveBackground": "#161E7A",
    "titleBar.inactiveForeground": "#FAFBFE"
  },
  "workbench.colorTheme": "Tokyo Night",
  "[python]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120
  }
}
